# Copie para .env e preencha somente no servidor. Nunca publique esse arquivo.
# Gere sua chave em https://platform.openai.com/api-keys (API cobrada separadamente).
IMAGE_API_KEY=
# Use uma senha exclusiva de 8 a 256 caracteres.
SITE_PASSWORD=
# Modelo de imagem compatível com geração e edição.
IMAGE_MODEL=gpt-image-1.5
PORT=3000
# Em produção, informe a URL HTTPS pública exata, sem barra final.
# PUBLIC_ORIGIN=https://imagens.seudominio.com
# No Render, a URL HTTPS é detectada automaticamente via RENDER_EXTERNAL_URL.
# No Railway, gere o domínio público; RAILWAY_PUBLIC_DOMAIN fornece o endereço.
# Somente se houver exatamente um proxy reverso confiável na frente do Node:
# TRUST_PROXY_HOPS=1
