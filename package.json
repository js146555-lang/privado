{
  "name": "atelie-privado",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.10.0" },
  "scripts": {
    "dev": "node --use-env-proxy --use-system-ca --watch --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env server/index.mjs --production",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
